{
  "manifest_version": 3,
  "name": "xreplies",
  "version": "0.1.0",
  "description": "Rising X posts worth replying to, and builders to connect with. Reads the local xreplies finder.",
  "action": { "default_title": "Open xreplies" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "tabs", "storage"],
  "host_permissions": ["http://127.0.0.1:5191/*"],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
